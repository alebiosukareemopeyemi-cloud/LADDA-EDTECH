# Every environment variable the app reads. Copy to .env.local and fill in.
# Never commit real values. Server-only values must never be sent to the browser.

# ---- Public (safe in the browser) ----
# Full site address, used for share links and the QR code, for example https://ladda.example.com
NEXT_PUBLIC_SITE_URL=
# 1 = demo mode: roadmap progress is kept in this browser and credentials are issued without the database.
NEXT_PUBLIC_USE_MOCKS=1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server only (secrets) ----
# Writes user_nodes, reviews and credentials, and reads credentials for /api/verify. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
# Reserved: not read by the app yet.
DATABASE_URL=
# Gemini key for the live repo review. Without it the review falls back to file checks.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.1-flash-lite (about 3 seconds a review).
GEMINI_MODEL=
# Reserved: the live review reads GitHub without a token, as designed. Not read by the app yet.
GITHUB_TOKEN=
# Reserved: sign-up email uses Supabase's sender for now. Not read by the app yet.
RESEND_API_KEY=

# Credential signing (ed25519, hex). Generate once with: node scripts/generate-keys.mjs
# Never change the private key after credentials are issued: it would invalidate them.
CREDENTIAL_PRIVATE_KEY=
CREDENTIAL_PUBLIC_KEY=
